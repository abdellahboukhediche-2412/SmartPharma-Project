<Window x:Class="SmartPharma.Views.ContactWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Contact - SmartPharma"
        Height="760"
        Width="620"
        MinHeight="650"
        MinWidth="560"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7F6">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->

        <Border Background="#0B3D3E"
                CornerRadius="18"
                Padding="25"
                Margin="0,0,0,20">

            <StackPanel>

                <TextBlock Text="💊 Contact SmartPharma"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock Text="Une question, une suggestion ou un problème ? Contactez notre équipe."
                           FontSize="14"
                           Foreground="#DDEFEA"
                           Margin="0,8,0,0"/>

            </StackPanel>

        </Border>

        <!-- ================= FORMULAIRE ================= -->

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="18"
                Padding="25">

            <Border.Effect>
                <DropShadowEffect BlurRadius="15"
                                  ShadowDepth="2"
                                  Opacity="0.15"/>
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel>

                    <!-- NOM -->

                    <TextBlock Text="👤  Nom"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#0B3D3E"/>

                    <TextBox x:Name="txtNom"
                             Height="42"
                             Margin="0,7,0,5"
                             Padding="12,0"
                             FontSize="14"
                             VerticalContentAlignment="Center"
                             BorderBrush="#BFCBC8"
                             BorderThickness="1"
                             Background="#FAFCFB"/>

                    <TextBlock x:Name="erreurNom"
                               Foreground="#E74C3C"
                               FontSize="12"
                               Visibility="Collapsed"
                               Margin="0,0,0,15"/>


                    <!-- COURRIEL -->

                    <TextBlock Text="📧  Courriel"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#0B3D3E"/>

                    <TextBox x:Name="txtEmail"
                             Height="42"
                             Margin="0,7,0,5"
                             Padding="12,0"
                             FontSize="14"
                             VerticalContentAlignment="Center"
                             BorderBrush="#BFCBC8"
                             BorderThickness="1"
                             Background="#FAFCFB"/>

                    <TextBlock x:Name="erreurEmail"
                               Foreground="#E74C3C"
                               FontSize="12"
                               Visibility="Collapsed"
                               Margin="0,0,0,15"/>


                    <!-- SUJET -->

                    <TextBlock Text="📌  Sujet"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#0B3D3E"/>

                    <ComboBox x:Name="cmbSujet"
                              Height="42"
                              Margin="0,7,0,5"
                              Padding="10,0"
                              FontSize="14"
                              Background="#FAFCFB"
                              BorderBrush="#BFCBC8"
                              BorderThickness="1">

                        <ComboBoxItem Content="Demande d'information"/>
                        <ComboBoxItem Content="Assistance technique"/>
                        <ComboBoxItem Content="Suggestion"/>
                        <ComboBoxItem Content="Signaler un problème"/>
                        <ComboBoxItem Content="Autre"/>

                    </ComboBox>

                    <TextBlock x:Name="erreurSujet"
                               Foreground="#E74C3C"
                               FontSize="12"
                               Visibility="Collapsed"
                               Margin="0,0,0,15"/>


                    <!-- MESSAGE -->

                    <TextBlock Text="💬  Message"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#0B3D3E"/>

                    <TextBox x:Name="txtMessage"
                             Height="170"
                             Margin="0,7,0,5"
                             Padding="12"
                             FontSize="14"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             BorderBrush="#BFCBC8"
                             BorderThickness="1"
                             Background="#FAFCFB"/>

                    <DockPanel Margin="0,0,0,15">

                        <TextBlock x:Name="erreurMessage"
                                   Foreground="#E74C3C"
                                   FontSize="12"
                                   Visibility="Collapsed"/>

                        <TextBlock x:Name="txtCompteur"
                                   Text="0 / 500"
                                   Foreground="#7F8C8D"
                                   FontSize="12"
                                   HorizontalAlignment="Right"
                                   DockPanel.Dock="Right"/>

                    </DockPanel>


                    <!-- SUCCÈS -->

                    <Border x:Name="messageSucces"
                            Background="#D4EDDA"
                            CornerRadius="10"
                            Padding="12"
                            Margin="0,5,0,10"
                            Visibility="Collapsed">

                        <TextBlock Text="✓ Votre message a été envoyé avec succès."
                                   Foreground="#155724"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   TextAlignment="Center"/>

                    </Border>


                    <!-- ERREUR -->

                    <Border x:Name="messageErreur"
                            Background="#F8D7DA"
                            CornerRadius="10"
                            Padding="12"
                            Margin="0,5,0,10"
                            Visibility="Collapsed">

                        <TextBlock Text="Une erreur est survenue lors de l'envoi du message."
                                   Foreground="#721C24"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   TextAlignment="Center"/>

                    </Border>


                    <!-- BOUTONS -->

                    <Grid Margin="0,15,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="btnEnvoyer"
                                Grid.Column="0"
                                Content="📩  Envoyer"
                                Height="48"
                                Background="#16845F"
                                Foreground="White"
                                FontSize="15"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="BtnEnvoyer_Click"/>

                        <Button Grid.Column="2"
                                Content="←  Retour"
                                Height="48"
                                Background="#0B3D3E"
                                Foreground="White"
                                FontSize="15"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="BtnRetour_Click"/>

                    </Grid>

                </StackPanel>

            </ScrollViewer>

        </Border>


        <!-- ================= FOOTER ================= -->

        <TextBlock Grid.Row="2"
                   Text="SmartPharma • Service de contact"
                   HorizontalAlignment="Center"
                   Margin="0,18,0,0"
                   FontSize="12"
                   Foreground="#7F8C8D"/>

    </Grid>
</Window>