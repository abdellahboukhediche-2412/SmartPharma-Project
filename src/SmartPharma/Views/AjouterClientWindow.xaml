<Window x:Class="SmartPharma.Views.AjouterClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajouter un client"
        Height="430"
        Width="450"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7F6">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Ajouter un client"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="#0B3D3E"
                   Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled">

            <Border Background="White"
            CornerRadius="10"
            Padding="20"
            Margin="0,0,8,0">

                <StackPanel>

                    <TextBlock Text="Nom"/>
                    <TextBox x:Name="txtNom"
                     Height="35"
                     Margin="0,5,0,15"/>

                    <TextBlock Text="Téléphone"/>
                    <TextBox x:Name="txtTelephone"
                     Height="35"
                     Margin="0,5,0,15"/>

                    <TextBlock Text="Email"/>
                    <TextBox x:Name="txtEmail"
                     Height="35"
                     Margin="0,5,0,15"/>

                    <TextBlock Text="Adresse"/>
                    <TextBox x:Name="txtAdresse"
                     Height="35"
                     Margin="0,5,0,15"/>

                </StackPanel>

            </Border>

        </ScrollViewer>

        <Button Grid.Row="2"
                Content="Enregistrer"
                Height="40"
                Background="#2ECC71"
                Foreground="White"
                FontWeight="Bold"
                Click="BtnEnregistrer_Click"/>
    </Grid>
</Window>