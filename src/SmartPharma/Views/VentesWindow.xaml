<Window x:Class="SmartPharma.Views.VentesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestion des ventes"
        Height="850"
        Width="1150"
        MinHeight="750"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7F6">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="230"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===================== HEADER ===================== -->

            <Border Grid.Row="0"
                    Background="#0B3D3E"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,0,0,20">

                <StackPanel>

                    <TextBlock Text="Gestion des ventes"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="Ajouter plusieurs médicaments à une même vente et mettre automatiquement le stock à jour"
                               FontSize="15"
                               Foreground="#DDEFEA"
                               Margin="0,5,0,0"/>

                </StackPanel>

            </Border>

            <!-- ===================== SÉLECTION MÉDICAMENT ===================== -->

            <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,0,0,20">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>

                    <!-- Médicament -->

                    <StackPanel Grid.Column="0">

                        <TextBlock Text="Médicament"
                                   FontWeight="Bold"
                                   Foreground="#0B3D3E"/>

                        <ComboBox x:Name="cmbMedicaments"
                                  Height="35"
                                  Margin="0,5,10,0"
                                  DisplayMemberPath="Nom"
                                  SelectedValuePath="Id"
                                  SelectionChanged="cmbMedicaments_SelectionChanged"/>

                    </StackPanel>

                    <!-- Prix -->

                    <StackPanel Grid.Column="1">

                        <TextBlock Text="Prix"
                                   FontWeight="Bold"
                                   Foreground="#0B3D3E"/>

                        <TextBox x:Name="txtPrix"
                                 Height="35"
                                 Margin="0,5,10,0"
                                 IsReadOnly="True"
                                 VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <!-- Stock -->

                    <StackPanel Grid.Column="2">

                        <TextBlock Text="Stock"
                                   FontWeight="Bold"
                                   Foreground="#0B3D3E"/>

                        <TextBox x:Name="txtStock"
                                 Height="35"
                                 Margin="0,5,10,0"
                                 IsReadOnly="True"
                                 VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <!-- Expiration -->

                    <StackPanel Grid.Column="3">

                        <TextBlock Text="Date expiration"
                                   FontWeight="Bold"
                                   Foreground="#0B3D3E"/>

                        <TextBox x:Name="txtExpiration"
                                 Height="35"
                                 Margin="0,5,10,0"
                                 IsReadOnly="True"
                                 VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <!-- Quantité -->

                    <StackPanel Grid.Column="4">

                        <TextBlock Text="Quantité"
                                   FontWeight="Bold"
                                   Foreground="#0B3D3E"/>

                        <TextBox x:Name="txtQuantite"
                                 Height="35"
                                 Margin="0,5,10,0"
                                 VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <!-- Ajouter au panier -->

                    <Button Grid.Column="5"
                            Height="35"
                            Margin="10,22,0,0"
                            Background="#3498DB"
                            Foreground="White"
                            FontWeight="Bold"
                            Content="Ajouter au panier"
                            Click="BtnAjouterPanier_Click"/>

                </Grid>

            </Border>

            <!-- ===================== PANIER ===================== -->

            <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="12"
                    Padding="15"
                    Margin="0,0,0,20">

                <StackPanel>

                    <DockPanel Margin="0,0,0,10">

                        <TextBlock Text="Panier de la vente"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#0B3D3E"
                                   VerticalAlignment="Center"/>

                        <Button Content="Supprimer du panier"
                                Width="170"
                                Height="35"
                                DockPanel.Dock="Right"
                                HorizontalAlignment="Right"
                                Background="#E74C3C"
                                Foreground="White"
                                FontWeight="Bold"
                                Click="BtnSupprimerPanier_Click"/>

                    </DockPanel>

                    <DataGrid x:Name="dgPanier"
                              Height="180"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              AlternatingRowBackground="#F2F6F5"
                              HeadersVisibility="Column"
                              RowHeight="35"
                              FontSize="14"
                              GridLinesVisibility="None"
                              BorderThickness="0">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Médicament"
                                                Binding="{Binding Medicament.Nom}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Prix unitaire"
                                                Binding="{Binding PrixUnitaire, StringFormat={}{0:N2} $}"
                                                Width="150"/>

                            <DataGridTextColumn Header="Quantité"
                                                Binding="{Binding Quantite}"
                                                Width="120"/>

                            <DataGridTextColumn Header="Sous-total"
                                                Binding="{Binding SousTotal, StringFormat={}{0:N2} $}"
                                                Width="150"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </StackPanel>

            </Border>

            <!-- ===================== TOTAL ===================== -->

            <Border Grid.Row="3"
                    Background="#0B3D3E"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,0,0,20">

                <DockPanel>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <TextBlock Text="💰 Montant total : "
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock x:Name="txtTotal"
                                   Text="0,00 $"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#2ECC71"/>

                    </StackPanel>

                    <Button x:Name="btnEnregistrerVente"
                            Content="Enregistrer la vente"
                            Width="190"
                            Height="42"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Right"
                            Background="#2ECC71"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="14"
                            Click="BtnEnregistrerVente_Click"/>

                </DockPanel>

            </Border>

            <!-- ===================== HISTORIQUE ===================== -->

            <Border Grid.Row="4"
        Background="White"
        CornerRadius="12"
        Padding="15"
        Margin="0,0,0,20"
        MinHeight="230">

                <StackPanel>

                    <!-- Titre + bouton Voir détails -->
                    <DockPanel Margin="5,5,0,10">

                        <TextBlock Text="Historique des ventes"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#0B3D3E"
                       VerticalAlignment="Center"/>

                        <Button Content="Voir détails"
                    Width="130"
                    Height="35"
                    DockPanel.Dock="Right"
                    HorizontalAlignment="Right"
                    Background="#3498DB"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="BtnVoirDetails_Click"/>

                    </DockPanel>

                    <!-- Tableau historique -->
                    <DataGrid x:Name="dgVentes"
                  Height="180"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  AlternatingRowBackground="#F2F6F5"
                  HeadersVisibility="Column"
                  RowHeight="40"
                  FontSize="14"
                  GridLinesVisibility="None"
                  BorderThickness="0">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="ID"
                                    Binding="{Binding Id}"
                                    Width="60"/>

                            <DataGridTextColumn Header="Date"
                                    Binding="{Binding DateVente, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                    Width="160"/>

                            <DataGridTextColumn Header="Médicaments"
                                    Binding="{Binding Medicaments}"
                                    Width="*"/>

                            <DataGridTextColumn Header="Quantité totale"
                                    Binding="{Binding QuantiteTotale}"
                                    Width="130"/>

                            <DataGridTextColumn Header="Montant total"
                                    Binding="{Binding MontantTotal, StringFormat={}{0:N2} $}"
                                    Width="140"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </StackPanel>

            </Border>
            <!-- ===================== FOOTER ===================== -->

            <DockPanel Grid.Row="5"
                       Margin="0,0,0,10">

                <TextBlock Text="SmartPharma - Module ventes"
                           FontWeight="Bold"
                           Foreground="#0B3D3E"
                           VerticalAlignment="Center"/>

                <Button Content="← Retour"
                        Width="130"
                        Height="40"
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        Background="#0B3D3E"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="BtnRetour_Click"/>

            </DockPanel>

        </Grid>

    </ScrollViewer>

</Window>