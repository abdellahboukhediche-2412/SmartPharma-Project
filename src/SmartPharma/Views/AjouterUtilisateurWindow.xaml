<Window x:Class="SmartPharma.Views.AjouterUtilisateurWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajouter un utilisateur"
        Height="620"
        Width="500"
        MinHeight="520"
        MinWidth="460"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7F6">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Margin="0,0,0,20">

            <TextBlock Text="Ajouter un utilisateur"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#0B3D3E"/>

            <TextBlock Text="Créer un nouveau compte d'accès à SmartPharma"
                       FontSize="14"
                       Foreground="#607D7D"
                       Margin="0,5,0,0"/>

        </StackPanel>

        <!-- Formulaire -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Border Background="White"
                    CornerRadius="12"
                    Padding="22"
                    Margin="0,0,8,0">

                <StackPanel>

                    <!-- Nom -->
                    <TextBlock Text="Nom"
                               FontWeight="SemiBold"
                               Foreground="#0B3D3E"/>

                    <TextBox x:Name="txtNom"
                             Height="38"
                             Margin="0,5,0,15"
                             Padding="10,0"
                             VerticalContentAlignment="Center"/>

                    <!-- Prénom -->
                    <TextBlock Text="Prénom"
                               FontWeight="SemiBold"
                               Foreground="#0B3D3E"/>

                    <TextBox x:Name="txtPrenom"
                             Height="38"
                             Margin="0,5,0,15"
                             Padding="10,0"
                             VerticalContentAlignment="Center"/>

                    <!-- Nom utilisateur -->
                    <TextBlock Text="Nom d'utilisateur"
                               FontWeight="SemiBold"
                               Foreground="#0B3D3E"/>

                    <TextBox x:Name="txtNomUtilisateur"
                             Height="38"
                             Margin="0,5,0,15"
                             Padding="10,0"
                             VerticalContentAlignment="Center"/>

                    <!-- Mot de passe -->
                    <TextBlock Text="Mot de passe"
                               FontWeight="SemiBold"
                               Foreground="#0B3D3E"/>

                    <PasswordBox x:Name="txtMotDePasse"
                                 Height="38"
                                 Margin="0,5,0,15"
                                 Padding="10"/>

                    <!-- Confirmation -->
                    <TextBlock Text="Confirmer le mot de passe"
                               FontWeight="SemiBold"
                               Foreground="#0B3D3E"/>

                    <PasswordBox x:Name="txtConfirmation"
                                 Height="38"
                                 Margin="0,5,0,15"
                                 Padding="10"/>

                    <!-- Actif -->
                    <CheckBox x:Name="chkActif"
                              Content="Compte actif"
                              IsChecked="True"
                              FontWeight="SemiBold"
                              Foreground="#0B3D3E"
                              Margin="0,5,0,5"/>

                </StackPanel>

            </Border>

        </ScrollViewer>

        <!-- Boutons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button Content="Annuler"
                    Width="110"
                    Height="40"
                    Margin="0,0,10,0"
                    Background="#7F8C8D"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="BtnAnnuler_Click"/>

            <Button Content="Enregistrer"
                    Width="150"
                    Height="40"
                    Background="#16845F"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="BtnEnregistrer_Click"/>

        </StackPanel>

    </Grid>
</Window>