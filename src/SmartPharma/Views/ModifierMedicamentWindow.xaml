<Window x:Class="SmartPharma.Views.ModifierMedicamentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modifier un médicament"
        Height="620"
        Width="470"
        MinHeight="520"
        MinWidth="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F4F7F6">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titre -->
        <StackPanel Margin="0,0,0,20">

            <TextBlock Text="Modifier un médicament"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#0B3D3E"/>

            <TextBlock Text="Modifiez les informations du médicament sélectionné"
                       FontSize="14"
                       Foreground="#607D7D"
                       Margin="0,5,0,0"/>

        </StackPanel>

        <!-- Formulaire avec barre de défilement -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Border Background="White"
                    CornerRadius="10"
                    Padding="20"
                    Margin="0,0,8,0">

                <StackPanel>

                    <TextBlock Text="Nom"
                               FontWeight="SemiBold"
                               Foreground="#0B3D3E"/>

                    <TextBox x:Name="txtNom"
                             Height="35"
                             Padding="8,0"
                             VerticalContentAlignment="Center"
                             Margin="0,5,0,15"/>

                    <TextBlock Text="Prix"
                               FontWeight="SemiBold"
                               Foreground="#0B3D3E"/>

                    <TextBox x:Name="txtPrix"
                             Height="35"
                             Padding="8,0"
                             VerticalContentAlignment="Center"
                             Margin="0,5,0,15"/>

                    <TextBlock Text="Quantité en stock"
                               FontWeight="SemiBold"
                               Foreground="#0B3D3E"/>

                    <TextBox x:Name="txtQuantite"
                             Height="35"
                             Padding="8,0"
                             VerticalContentAlignment="Center"
                             Margin="0,5,0,15"/>

                    <TextBlock Text="Quantité par boîte"
                               FontWeight="SemiBold"
                               Foreground="#0B3D3E"/>

                    <TextBox x:Name="txtQuantiteParBoite"
                             Height="35"
                             Padding="8,0"
                             VerticalContentAlignment="Center"
                             Margin="0,5,0,15"/>

                    <TextBlock Text="Forme du médicament"
                               FontWeight="SemiBold"
                               Foreground="#0B3D3E"/>

                    <ComboBox x:Name="cmbForme"
                              Height="35"
                              Margin="0,5,0,15">

                        <ComboBoxItem Content="Comprimé"/>
                        <ComboBoxItem Content="Gélule"/>
                        <ComboBoxItem Content="Sirop"/>
                        <ComboBoxItem Content="Gel"/>
                        <ComboBoxItem Content="Crème"/>
                        <ComboBoxItem Content="Pommade"/>
                        <ComboBoxItem Content="Solution"/>
                        <ComboBoxItem Content="Injection"/>
                        <ComboBoxItem Content="Suppositoire"/>

                    </ComboBox>

                    <TextBlock Text="Date d'expiration"
                               FontWeight="SemiBold"
                               Foreground="#0B3D3E"/>

                    <DatePicker x:Name="dpExpiration"
                                Height="35"
                                Margin="0,5,0,15"/>

                </StackPanel>

            </Border>

        </ScrollViewer>

        <!-- Boutons fixes -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button Content="Annuler"
                    Width="110"
                    Height="38"
                    Margin="0,0,10,0"
                    Background="#7F8C8D"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="BtnAnnuler_Click"/>

            <Button Content="Enregistrer les modifications"
                    Width="210"
                    Height="38"
                    Background="#F39C12"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="BtnModifier_Click"/>

        </StackPanel>

    </Grid>
</Window>