<Window x:Class="SmartPharma.Views.RapportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rapports et statistiques"
        Height="820"
        Width="1150"
        MinHeight="700"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7F6">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->

        <Border Background="#0B3D3E"
                CornerRadius="12"
                Padding="20"
                Margin="0,0,0,20">

            <DockPanel>

                <StackPanel>
                    <TextBlock Text="Rapports et statistiques"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="Vue générale de l'activité de la pharmacie"
                               FontSize="15"
                               Foreground="#DDEFEA"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <Button Content="Actualiser"
                        Width="120"
                        Height="38"
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="#2ECC71"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="BtnActualiser_Click"/>

            </DockPanel>

        </Border>

        <!-- ================= CONTENU ================= -->

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel>

                <!-- PREMIÈRE LIGNE -->

                <WrapPanel HorizontalAlignment="Center">

                    <!-- Médicaments -->
                    <Border Width="240"
                            Height="115"
                            Background="White"
                            CornerRadius="12"
                            Margin="8"
                            Padding="18">

                        <StackPanel>
                            <TextBlock Text="Médicaments"
                                       FontSize="15"
                                       Foreground="#555"/>

                            <TextBlock x:Name="txtTotalMedicaments"
                                       Text="0"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="#2ECC71"/>
                        </StackPanel>

                    </Border>

                    <!-- Clients -->
                    <Border Width="240"
                            Height="115"
                            Background="White"
                            CornerRadius="12"
                            Margin="8"
                            Padding="18">

                        <StackPanel>
                            <TextBlock Text="Clients"
                                       FontSize="15"
                                       Foreground="#555"/>

                            <TextBlock x:Name="txtTotalClients"
                                       Text="0"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="#3498DB"/>
                        </StackPanel>

                    </Border>

                    <!-- Fournisseurs -->
                    <Border Width="240"
                            Height="115"
                            Background="White"
                            CornerRadius="12"
                            Margin="8"
                            Padding="18">

                        <StackPanel>
                            <TextBlock Text="Fournisseurs"
                                       FontSize="15"
                                       Foreground="#555"/>

                            <TextBlock x:Name="txtTotalFournisseurs"
                                       Text="0"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="#9B59B6"/>
                        </StackPanel>

                    </Border>

                    <!-- Total ventes -->
                    <Border Width="240"
                            Height="115"
                            Background="White"
                            CornerRadius="12"
                            Margin="8"
                            Padding="18">

                        <StackPanel>
                            <TextBlock Text="Nombre total de ventes"
                                       FontSize="15"
                                       Foreground="#555"/>

                            <TextBlock x:Name="txtTotalVentes"
                                       Text="0"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="#E67E22"/>
                        </StackPanel>

                    </Border>

                </WrapPanel>

                <!-- DEUXIÈME LIGNE -->

                <WrapPanel HorizontalAlignment="Center">

                    <!-- Montant -->
                    <Border Width="240"
                            Height="125"
                            Background="#0B3D3E"
                            CornerRadius="12"
                            Margin="8"
                            Padding="18">

                        <StackPanel>
                            <TextBlock Text="Montant total des ventes"
                                       FontSize="15"
                                       Foreground="White"/>

                            <TextBlock x:Name="txtMontantVentes"
                                       Text="0,00 $"
                                       FontSize="27"
                                       FontWeight="Bold"
                                       Foreground="#2ECC71"
                                       Margin="0,8,0,0"/>
                        </StackPanel>

                    </Border>

                    <!-- Ventes aujourd'hui -->
                    <Border Width="240"
                            Height="125"
                            Background="#E8F4FD"
                            CornerRadius="12"
                            Margin="8"
                            Padding="18">

                        <StackPanel>

                            <TextBlock Text="Ventes aujourd'hui"
                                       FontSize="15"
                                       Foreground="#555"/>

                            <TextBlock x:Name="txtVentesAujourdhui"
                                       Text="0"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="#2980B9"/>

                            <TextBlock x:Name="txtMontantAujourdhui"
                                       Text="0,00 $"
                                       FontWeight="Bold"
                                       Foreground="#2980B9"/>

                        </StackPanel>

                    </Border>

                    <!-- Stock faible -->
                    <Border Width="240"
                            Height="125"
                            Background="#FFF3E0"
                            CornerRadius="12"
                            Margin="8"
                            Padding="18">

                        <StackPanel>
                            <TextBlock Text="Stock faible"
                                       FontSize="15"
                                       Foreground="#555"/>

                            <TextBlock x:Name="txtStockFaible"
                                       Text="0"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="#F39C12"/>

                            <TextBlock Text="Moins de 10 unités"
                                       FontSize="12"
                                       Foreground="#777"/>
                        </StackPanel>

                    </Border>

                    <!-- Expirés -->
                    <Border Width="240"
                            Height="125"
                            Background="#FDEDEC"
                            CornerRadius="12"
                            Margin="8"
                            Padding="18">

                        <StackPanel>
                            <TextBlock Text="Médicaments expirés"
                                       FontSize="15"
                                       Foreground="#555"/>

                            <TextBlock x:Name="txtMedicamentsExpires"
                                       Text="0"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="#E74C3C"/>
                        </StackPanel>

                    </Border>

                </WrapPanel>

                <!-- Proche expiration -->

                <Border Background="#FFF8E1"
                        CornerRadius="12"
                        Margin="8,15,8,15"
                        Padding="20">

                    <DockPanel>

                        <StackPanel>
                            <TextBlock Text="Médicaments proches de l'expiration"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#7D6608"/>

                            <TextBlock Text="Expiration prévue dans les 30 prochains jours"
                                       FontSize="13"
                                       Foreground="#777"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <TextBlock x:Name="txtProcheExpiration"
                                   Text="0"
                                   FontSize="35"
                                   FontWeight="Bold"
                                   Foreground="#F39C12"
                                   HorizontalAlignment="Right"
                                   DockPanel.Dock="Right"/>

                    </DockPanel>

                </Border>


                <!-- ================= GRAPHIQUE ================= -->

                <Border Background="White"
                        CornerRadius="12"
                        Margin="8"
                        Padding="20">

                    <StackPanel>

                        <TextBlock Text="Ventes des 7 derniers jours"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#0B3D3E"/>

                        <TextBlock Text="Montant total des ventes par jour"
                                   FontSize="13"
                                   Foreground="#777"
                                   Margin="0,4,0,20"/>

                        <Border Background="#F8FAFA"
                                CornerRadius="8"
                                Padding="20">

                            <StackPanel x:Name="spGraphiqueVentes"
                                        Height="230"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"/>

                        </Border>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>


        <!-- ================= FOOTER ================= -->

        <DockPanel Grid.Row="2"
                   Margin="0,20,0,0">

            <TextBlock Text="SmartPharma - Rapports et statistiques"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       Foreground="#0B3D3E"/>

            <Button Content="← Retour"
                    Width="130"
                    Height="40"
                    DockPanel.Dock="Right"
                    HorizontalAlignment="Right"
                    Background="#0B3D3E"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="BtnRetour_Click"/>

        </DockPanel>

    </Grid>

</Window>