<Window x:Class="SmartPharma.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connexion - SmartPharma"
        Height="500"
        Width="500"
        MinHeight="400"
        MinWidth="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F4F7F6">

    <Grid Background="#F4F7F6">

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Grid Margin="35">

                <Border Background="White"
                        CornerRadius="18"
                        Padding="30"
                        MaxWidth="430"
                        HorizontalAlignment="Center">

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15"
                                          ShadowDepth="2"
                                          Opacity="0.15"/>
                    </Border.Effect>

                    <StackPanel>

                        <!-- TITRE -->
                        <TextBlock Text="SmartPharma"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="#0B3D3E"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Connexion à votre espace"
                                   FontSize="15"
                                   Foreground="#607D7D"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,30"/>

                        <!-- NOM D'UTILISATEUR -->
                        <TextBlock Text="Nom d'utilisateur"
                                   FontWeight="SemiBold"
                                   Foreground="#0B3D3E"/>

                        <TextBox x:Name="txtNomUtilisateur"
                                 Height="42"
                                 Margin="0,7,0,20"
                                 Padding="10"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"/>

                        <!-- MOT DE PASSE -->
                        <TextBlock Text="Mot de passe"
                                   FontWeight="SemiBold"
                                   Foreground="#0B3D3E"/>

                        <PasswordBox x:Name="txtMotDePasse"
                                     Height="42"
                                     Margin="0,7,0,10"
                                     Padding="10"
                                     FontSize="14"
                                     VerticalContentAlignment="Center"/>

                        <!-- SE SOUVENIR -->
                        <CheckBox x:Name="chkSeSouvenir"
                                  Content="Se souvenir de moi"
                                  Margin="0,0,0,20"
                                  Foreground="#0B3D3E"/>

                        <!-- MESSAGE D'ERREUR -->
                        <TextBlock x:Name="txtErreur"
                                   Foreground="#E74C3C"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   Margin="0,0,0,15"/>

                        <!-- CONNEXION -->
                        <Button Content="Se connecter"
                                Height="45"
                                Background="#16845F"
                                Foreground="White"
                                FontSize="15"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="BtnConnexion_Click"/>

                        <!-- QUITTER -->
                        <Button Content="Quitter"
                                Height="40"
                                Margin="0,12,0,0"
                                Background="#0B3D3E"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="BtnQuitter_Click"/>

                    </StackPanel>

                </Border>

            </Grid>

        </ScrollViewer>

    </Grid>

</Window>