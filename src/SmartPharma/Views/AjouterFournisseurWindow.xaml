<Window x:Class="SmartPharma.Views.AjouterFournisseurWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajouter un fournisseur"
        Height="500"
        Width="470"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F7F6">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Ajouter un fournisseur"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#0B3D3E"/>

            <TextBlock Text="Saisissez les informations du nouveau fournisseur"
                       FontSize="14"
                       Foreground="#607D7D"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled">

            <Border Background="White"
            CornerRadius="10"
            Padding="20"
            Margin="0,0,8,0">

                <StackPanel>

                    <TextBlock Text="Nom"/>
                    <TextBox x:Name="txtNom"
                     Height="35"
                     Margin="0,5,0,12"/>

                    <TextBlock Text="Entreprise"/>
                    <TextBox x:Name="txtEntreprise"
                     Height="35"
                     Margin="0,5,0,12"/>

                    <TextBlock Text="Téléphone"/>
                    <TextBox x:Name="txtTelephone"
                     Height="35"
                     Margin="0,5,0,12"/>

                    <TextBlock Text="Email"/>
                    <TextBox x:Name="txtEmail"
                     Height="35"
                     Margin="0,5,0,12"/>

                    <TextBlock Text="Adresse"/>
                    <TextBox x:Name="txtAdresse"
                     Height="35"
                     Margin="0,5,0,12"/>

                </StackPanel>

            </Border>

        </ScrollViewer>
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button Content="Annuler"
                    Width="110"
                    Height="38"
                    Margin="0,0,10,0"
                    Background="#7F8C8D"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="BtnAnnuler_Click"/>

            <Button Content="Enregistrer"
                    Width="140"
                    Height="38"
                    Background="#2ECC71"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="BtnEnregistrer_Click"/>

        </StackPanel>
    </Grid>
</Window>