<Window x:Class="SmartPharma.Views.DetailsVenteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Détails de la vente"
        Height="600"
        Width="850"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7F6">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="#0B3D3E"
                CornerRadius="12"
                Padding="20"
                Margin="0,0,0,20">

            <StackPanel>

                <TextBlock Text="Détails de la vente"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock Text="Informations complètes de la transaction"
                           FontSize="14"
                           Foreground="#DDEFEA"
                           Margin="0,5,0,0"/>

            </StackPanel>

        </Border>

        <!-- INFORMATIONS -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="20"
                Margin="0,0,0,20">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <TextBlock Text="Numéro de vente"
                               FontWeight="Bold"
                               Foreground="#0B3D3E"/>

                    <TextBlock x:Name="txtNumeroVente"
                               FontSize="18"
                               Margin="0,5,0,0"/>

                </StackPanel>

                <StackPanel Grid.Column="1">

                    <TextBlock Text="Date"
                               FontWeight="Bold"
                               Foreground="#0B3D3E"/>

                    <TextBlock x:Name="txtDateVente"
                               FontSize="18"
                               Margin="0,5,0,0"/>

                </StackPanel>

                <StackPanel Grid.Column="2">

                    <TextBlock Text="Montant total"
                               FontWeight="Bold"
                               Foreground="#0B3D3E"/>

                    <TextBlock x:Name="txtMontantTotal"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#16845F"
                               Margin="0,5,0,0"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- LIGNES DE VENTE -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="12"
                Padding="15">

            <StackPanel>

                <TextBlock Text="Médicaments vendus"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#0B3D3E"
                           Margin="0,0,0,10"/>

                <DataGrid x:Name="dgDetails"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          AlternatingRowBackground="#F2F6F5"
                          HeadersVisibility="Column"
                          RowHeight="38"
                          FontSize="14"
                          GridLinesVisibility="None"
                          BorderThickness="0">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Médicament"
                                            Binding="{Binding Medicament.Nom}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Prix unitaire"
                                            Binding="{Binding PrixUnitaire, StringFormat={}{0:N2} $}"
                                            Width="150"/>

                        <DataGridTextColumn Header="Quantité"
                                            Binding="{Binding Quantite}"
                                            Width="120"/>

                        <DataGridTextColumn Header="Sous-total"
                                            Binding="{Binding SousTotal, StringFormat={}{0:N2} $}"
                                            Width="150"/>

                    </DataGrid.Columns>

                </DataGrid>

            </StackPanel>

        </Border>

        <!-- RETOUR -->
        <Button Grid.Row="3"
                Content="← Fermer"
                Width="130"
                Height="40"
                HorizontalAlignment="Right"
                Margin="0,20,0,0"
                Background="#0B3D3E"
                Foreground="White"
                FontWeight="Bold"
                Click="BtnFermer_Click"/>

    </Grid>
</Window>