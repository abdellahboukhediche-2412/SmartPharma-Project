<Window x:Class="SmartPharma.Views.AjouterMedicamentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajouter un médicament"
        Height="600"
        Width="470"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F7F6">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titre -->
        <StackPanel Margin="0,0,0,20">

            <TextBlock Text="Ajouter un médicament"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#0B3D3E"/>

            <TextBlock Text="Saisissez les informations du médicament"
                       FontSize="14"
                       Foreground="#607D7D"
                       Margin="0,5,0,0"/>

        </StackPanel>

        <!-- Zone défilable -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Border Background="White"
                    CornerRadius="10"
                    Padding="20"
                    Margin="0,0,8,0">

                <StackPanel>

                    <TextBlock Text="Nom"/>
                    <TextBox x:Name="txtNom"
                             Height="35"
                             Margin="0,5,0,15"/>

                    <TextBlock Text="Prix"/>
                    <TextBox x:Name="txtPrix"
                             Height="35"
                             Margin="0,5,0,15"/>

                    <TextBlock Text="Quantité en stock"/>
                    <TextBox x:Name="txtQuantite"
                             Height="35"
                             Margin="0,5,0,15"/>

                    <TextBlock Text="Quantité par boîte"/>
                    <TextBox x:Name="txtQuantiteParBoite"
                             Height="35"
                             Margin="0,5,0,15"/>

                    <TextBlock Text="Forme du médicament"/>

                    <ComboBox x:Name="cmbForme"
                              Height="35"
                              Margin="0,5,0,15">

                        <ComboBoxItem Content="Comprimé"/>
                        <ComboBoxItem Content="Gélule"/>
                        <ComboBoxItem Content="Sirop"/>
                        <ComboBoxItem Content="Gel"/>
                        <ComboBoxItem Content="Crème"/>
                        <ComboBoxItem Content="Pommade"/>
                        <ComboBoxItem Content="Solution"/>
                        <ComboBoxItem Content="Injection"/>
                        <ComboBoxItem Content="Suppositoire"/>

                    </ComboBox>

                    <TextBlock Text="Date d'expiration"/>

                    <DatePicker x:Name="dpExpiration"
                                Height="35"
                                Margin="0,5,0,15"/>

                </StackPanel>

            </Border>

        </ScrollViewer>

        <!-- Boutons fixes en bas -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button Content="Annuler"
                    Width="110"
                    Height="38"
                    Margin="0,0,10,0"
                    Background="#7F8C8D"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="BtnAnnuler_Click"/>

            <Button Content="Enregistrer"
                    Width="140"
                    Height="38"
                    Background="#2ECC71"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="BtnEnregistrer_Click"/>

        </StackPanel>

    </Grid>
</Window>